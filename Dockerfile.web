# Сборка UI grantor: stage 1 — node-сборка Vite, stage 2 — nginx со
# статикой и прокси на api (deploy/nginx/nginx.conf).

FROM node:22-alpine AS build

WORKDIR /app

# Воспроизводимая установка из зафиксированного web/package-lock.json
# (тот же npm ci, что и в CI).
COPY web/package*.json ./
COPY web/packages/project-ui/package.json ./packages/project-ui/package.json
RUN npm ci --no-audit --no-fund

COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine

# Заменяем дефолтный конфиг образа собственным (SPA + прокси /api, /auth,
# /health, /metrics на сервис api).
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
